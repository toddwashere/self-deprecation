{
  "name": "self-deprecation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "vite build --config web/vite.config.ts && node scripts/embed-panel.mjs",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:reset:local": "tsx scripts/db-reset.ts",
    "seed:local": "tsx scripts/seed.ts",
    "snapshot:feeds": "tsx scripts/snapshot-feeds.ts",
    "smoke:prod": "tsx scripts/smoke-prod.ts",
    "smoke:decisions": "tsx scripts/smoke-decisions.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@openai/mcp-extensions": "0.2.1",
    "agents": "0.30.1",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@openai/mcp-extensions": {
      "zod": "4.6.7"
    }
  }
}
