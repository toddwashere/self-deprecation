{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "self-deprecation",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "DECISIONS_ENABLED": "1",
    "DECISIONS_DAILY_JOB_CAP": "300",
    "DECISIONS_BATCH_SIZE": "20",
    "DECISIONS_CONCURRENCY": "3",
    "PUBLIC_BASE_URL": "https://self-deprecation.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "self-deprecation",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
